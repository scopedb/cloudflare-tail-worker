CREATE TABLE IF NOT EXISTS scopedb.public.cloudflare_worker_events (
    event_id string COMMENT 'Unique row identifier',
    occurred_at timestamp COMMENT 'Event timestamp in UTC',
    service string COMMENT 'Producer Worker name (scriptName)',
    event_type string COMMENT 'worker.invocation, worker.log, or worker.exception',
    outcome string COMMENT 'Worker execution outcome (ok, exception, exceededCpu, etc.)',
    level string COMMENT 'Normalized severity (debug, info, warn, error)',
    method string COMMENT 'HTTP request method when triggered by fetch',
    host string COMMENT 'Request URL hostname',
    path string COMMENT 'Request URL pathname without query parameters',
    status int COMMENT 'HTTP response status code',
    ray_id string COMMENT 'Cloudflare Ray ID (cf-ray)',
    message string COMMENT 'Human-readable event summary, log line, or exception message',
    attributes object COMMENT 'Structured invocation timings, edge metadata, log arguments, or stack trace'
)
CLUSTER BY service, occurred_at
COMMENT = 'Cloudflare Worker invocations, console logs, and uncaught exceptions';

CREATE OR REPLACE VIEW scopedb.public.v_cloudflare_requests AS
    FROM scopedb.public.cloudflare_worker_events
    WHERE event_type = 'worker.invocation'
    SELECT
        occurred_at,
        service,
        outcome,
        level,
        method,
        host,
        path,
        status,
        ray_id,
        attributes['invocation_id']::string AS invocation_id,
        attributes['wall_time_ms']::float AS wall_time_ms,
        attributes['cpu_time_ms']::float AS cpu_time_ms,
        attributes['log_count']::int AS log_count,
        attributes['exception_count']::int AS exception_count,
        attributes['colo']::string AS colo,
        attributes['country']::string AS country,
        attributes['asn']::int AS asn,
        attributes['as_organization']::string AS as_organization,
        attributes['user_agent']::string AS user_agent,
        attributes['accept']::string AS accept,
        attributes['referer_host']::string AS referer_host,
        attributes['verified_bot_category']::string AS verified_bot_category
COMMENT = 'Flattened Cloudflare Worker HTTP and non-HTTP invocation metrics';

CREATE OR REPLACE VIEW scopedb.public.v_cloudflare_errors AS
    FROM scopedb.public.cloudflare_worker_events
    WHERE level = 'error'
       OR outcome != 'ok'
       OR (status IS NOT NULL AND status >= 500)
    SELECT
        occurred_at,
        service,
        event_type,
        outcome,
        level,
        method,
        host,
        path,
        status,
        ray_id,
        message,
        attributes['invocation_id']::string AS invocation_id,
        attributes['exception_name']::string AS exception_name,
        attributes['stack']::string AS stack,
        attributes
COMMENT = 'Cloudflare Worker 5xx responses, non-ok outcomes, error logs, and uncaught exceptions';

CREATE OR REPLACE VIEW scopedb.public.v_cloudflare_ai_bots AS
    FROM scopedb.public.cloudflare_worker_events
    WHERE event_type = 'worker.invocation'
    SELECT
        occurred_at,
        service,
        outcome,
        method,
        host,
        path,
        status,
        ray_id,
        attributes['wall_time_ms']::float AS wall_time_ms,
        attributes['cpu_time_ms']::float AS cpu_time_ms,
        attributes['user_agent']::string AS user_agent,
        attributes['accept']::string AS accept,
        attributes['referer_host']::string AS referer_host,
        attributes['country']::string AS country,
        attributes['as_organization']::string AS as_organization,
        attributes['verified_bot_category']::string AS verified_bot_category
    WHERE path = '/llms.txt'
       OR ends_with(path, '.md')
       OR contains(accept, 'text/markdown')
       OR verified_bot_category IS NOT NULL
       OR regexp_like(
           user_agent,
           regex => '(?i)(ClaudeBot|Claude-Web|Claude-User|Anthropic|GPTBot|ChatGPT-User|OAI-SearchBot|Codex|Cursor|PerplexityBot|Perplexity-User|CCBot|Google-Extended|Applebot-Extended|Bytespider|Amazonbot|cohere-ai|YouBot)'
       )
COMMENT = 'Cloudflare Worker requests from AI crawlers, coding agents, and Markdown/llms.txt readers';
